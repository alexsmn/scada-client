@startuml opcua-discovery-flow
!include _style.puml

' OPC UA client discovery + endpoint-driven security selection.

title OPC UA client — discovery and endpoint-driven security selection

autonumber

participant "Login UI" as UI $external
participant "ClientSession" as CS $tier
participant "DiscoveryClient" as DC $tier
participant "SelectEndpoint" as SEL $tier
participant "ClientProtocolSession" as PS $tier
participant "OPC UA Server" as SRV $external

UI -> CS : ConnectAsync(host, SecuritySettings)

note over CS, SRV : Phase 1 — discovery over a transient None channel
CS -> DC : GetEndpoints(endpoint_url)
DC -> SRV : HEL / ACK
DC -> SRV : OpenSecureChannel (SecurityPolicy=None)
DC -> SRV : GetEndpointsRequest
SRV --> DC : EndpointDescription[]\n(policyUri, mode, serverCert, userTokens[])
DC -> SRV : CloseSecureChannel

note over CS, SEL : Phase 2 — choose a supported endpoint
CS -> SEL : SelectEndpoint(endpoints, preference, capabilities)
alt no compatible endpoint
  SEL --> CS : Bad_SecurityPolicyRejected (offered vs supported)
  CS --> UI : error
else endpoint chosen
  SEL --> CS : EndpointDescription (policy, mode, serverCert)
end

note over CS, SRV : Phase 3 — secure working session
CS -> PS : Create(Security{policy, mode, serverCert, clientCert/key})
PS -> SRV : OpenSecureChannel (chosen policy)
PS -> SRV : CreateSessionRequest
SRV --> PS : CreateSessionResponse (serverCert, serverNonce)
PS -> SRV : ActivateSessionRequest (identity token; clientSignature — gap 2)
SRV --> PS : ActivateSessionResponse
PS --> CS : Good
CS --> UI : connected

@enduml
