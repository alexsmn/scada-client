@startuml module-graph
!include _style.puml

title Qt client — module graph

rectangle "**CoreModule**\n//core///\ntracer · registries ·\nprogress host" as Core $tier

package "Domain modules" as Domain {
  rectangle "EventModule\n//modules/events///" as Event $neutral
  rectangle "ConfigurationModule\n//modules/configuration///" as Config $neutral
  rectangle "CsvExportModule\n//modules/export/csv///" as Csv $neutral
  rectangle "ExportConfigurationModule\n//modules/export/configuration///" as ExportCfg $neutral
  rectangle "DebuggerModule\n//modules/debugger///" as Debug $neutral
  rectangle "FavoritesModule\n//modules/favorites///" as Fav $neutral
  rectangle "PortfolioModule\n//modules/portfolio///" as Portfolio $neutral
  rectangle "ModusModule\n//modules/modus///\n(Qt only)" as Modus $config
  rectangle "VidiconModule\n//modules/vidicon///\n(Qt only)" as Vidicon $config
}

rectangle "**MainWindowModule**\n//main_window///\norchestrates pages,\nviews & alarms" as MW $store

Core --> Event
Core --> Config
Core --> Csv
Core --> ExportCfg
Core --> Debug
Core --> Fav
Core --> Portfolio
Core --> Modus
Core --> Vidicon

Event --> MW : local_events,\nnode_event_provider
Fav --> MW : favourites
Portfolio --> MW : portfolio_manager
Event ..> Vidicon : local_events
Fav ..> Modus : profile

@enduml
