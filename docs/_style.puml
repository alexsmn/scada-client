' Shared PlantUML house style — see the superproject CLAUDE.md,
' "Documentation Conventions / PlantUML house style".
'
' Include it as the first line of every diagram in this directory:
'     !include _style.puml
'
' This file is deliberately not a diagram (no @startuml/@enduml), so
' rendering the directory never emits a stray empty image.
'
' Keep the copies in the other repos' diagram directories in sync; each
' repo carries its own copy so it stays standalone-buildable.

!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #5B6B7F
skinparam RectangleBorderColor #5B6B7F
skinparam RectangleFontColor #1B2530
skinparam PackageBorderColor #5B6B7F
skinparam ParticipantBorderColor #5B6B7F
skinparam SequenceLifeLineBorderColor #5B6B7F
skinparam NoteBackgroundColor #FDEBCF
skinparam NoteBorderColor #B07D1D

' Shared palette — colour means the same thing in every diagram.
' Use AFTER the semicolon on activities (":text; <<$tier>>"); the legacy
' "#RRGGBB:text;" prefix form draws a deprecation banner into the image.
'
'   $neutral   ordinary activity / box
'   $tier      a server tier or component
'   $config    configuration-serving element
'   $store     historian, database, good terminal state
'   $hazard    failure mode, regression, warning
'   $external  external actor, not-taken branch
'   $proxy     the aggregating proxy

!$neutral = "#EEF2F7"
!$tier = "#D0E0F0"
!$config = "#FDEBCF"
!$store = "#D7F0DB"
!$hazard = "#F7C9C2"
!$external = "#F4F6F8"
!$proxy = "#E6D0F0"
