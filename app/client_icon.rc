// The client's Windows resource script.
//
// It carries the application icon and nothing else. Windows reads the
// executable's shell icon from the ICON resource with the lowest id, and there
// is no way to supply one other than through a resource script — so this file
// stays even though the rest of the client's Win32 resources are gone.
//
// Everything the former `common.rc` held (dialog templates, menus, toolbars,
// bitmaps, string tables, accelerators) was dead or has moved:
//   * dialogs and menus     -> Qt widgets and `aui::MenuModel`s;
//   * icon strips           -> res/client.qrc (see resources/icon_strips.h);
//   * version information   -> generated by scada_add_windows_version_info().
// Do not grow this file back into a UI definition — new UI belongs in Qt.

#include "resources/client_icon_resources.h"

IDI_APP_ICON ICON "..\\res\\client.ico"
