<RCC>
    <qresource prefix="/">
        <file>client.ico</file>
        <file>device.png</file>
    </qresource>
    <!-- Toolbar/command action icons, addressable as :/res/<name>.png. Kept in
         lock-step with the id->path table in aui/qt/client_utils_qt.cpp.
         wintypes.bmp is the last horizontal icon strip sliced by aui's
         LoadIcons() (magenta 255,0,255 is the transparency key); it was a
         Win32 BITMAP resource (IDB_WIN_TYPES) until the client resource
         script was dropped. items.bmp is retired — its consumers render the
         Lucide glyphs under /icons instead. -->
    <qresource prefix="/res">
        <file>wintypes.bmp</file>
        <file>acknowledge_all.png</file>
        <file>chart_curve.png</file>
        <file>copy.png</file>
        <file>delete.png</file>
        <file>display.png</file>
        <file>doc_table.png</file>
        <file>event_view.png</file>
        <file>events3.png</file>
        <file>execute.png</file>
        <file>paste.png</file>
        <file>printer.png</file>
        <file>record_editor.png</file>
        <file>summary.png</file>
        <file>table.png</file>
        <file>unlock.png</file>
        <file>write_manual.png</file>
        <file>settings/settings64-32bit.png</file>
    </qresource>
    <!-- Lucide (ISC, res/icons/LICENSE): 24px grid, stroke 2, round caps,
         stroke="currentColor" so one file serves dark, light and
         high-contrast. Tint is applied by the consumer, never baked into the
         file (docs/ux/iconography.md §4). Keep alphabetical. -->
    <qresource prefix="/">
        <file>icons/folder.svg</file>
        <file>icons/network.svg</file>
        <file>icons/router.svg</file>
        <file>icons/variable.svg</file>
    </qresource>
</RCC>
